# VERUM OTC — variáveis de ambiente (nunca commitar valores reais; produção lê de secret manager)
OTC_ENV=dev                 # dev | testnet | staging | prod
PORT=8080
HOST=127.0.0.1
DATABASE_MODE=memory        # memory | pglite | postgres (prod exige postgres + DATABASE_URL)
DATABASE_URL=
SESSION_SECRET=             # >= 32 caracteres, rotacionável; obrigatório em prod
SESSION_TTL_MS=600000
OPERATOR_ADDRESSES=         # endereços de operadores (backoffice), separados por vírgula
TREASURY_ADDRESS=0x000000000000000000000000000000000000dEaD
PLATFORM_FEE_BPS=3          # taxa da plataforma em bps: 3 = 0,03% = 0.0003 (fee = volume * 0.0003)
PAYMASTER_SHARE_BPS=0
EXEC_MARGIN_MS=60000
MAX_DEAL_USD=100000
EXPIRY_SCAN_MS=5000
APP_DOMAIN=otc.verumcrypto.com
PORTAL_HTML_PATH=./web/verum-saas.html      # portal Pay Master (cadastro/login) em /portal
MESA_HTML_PATH=./web/verum-dashboard.html   # mesa de operação em /mesa
CONVITE_HTML_PATH=./web/verum-convite.html  # página de confirmação do convite em /convite/:token
# Zcash lê saldo pelo lightwalletd público (zec.rocks, SEM chave). As chaves abaixo são só fallback opcional.
NOWNODES_API_KEY=           # opcional: fallback NOWNodes (nownodes.io, plano free) via Blockbook
BLOCKCHAIR_API_KEY=         # opcional: fallback Blockchair (blockchair.com/api, paga)
TRONGRID_API_KEY=           # chave TronGrid (trongrid.io) p/ saldo/TRC-20 do Tron; sem ela, IP compartilhado (serverless) pode ser limitado e o Tron fica "indisponível"
LOG_LEVEL=info

# ============================================================================
# Escrow canônico Verum (contratos verum-otc-onchain) — grupos ALL-OR-NOTHING.
# Grupo incompleto = erro de boot; grupo ausente = modo simulado (LocalChainAdapter).
# ============================================================================
# EVM (VerumOTCEscrowEVM em anvil/Sepolia). Tem precedência sobre o modo EVM_* legado.
VERUM_EVM_RPC_URL=
VERUM_EVM_CHAIN_ID=         # 31337 (anvil) | 11155111 (Sepolia)
VERUM_EVM_ESCROW_ADDRESS=
VERUM_EVM_KEEPER_KEY=       # executor/relayer — NUNCA a chave de um participante
VERUM_EVM_ATTESTOR_KEY=     # assina WalletAttestations (testnet: backend; mainnet: HSM/KMS)
VERUM_EVM_TBTC=
VERUM_EVM_TUSDT=
VERUM_EVM_CONFIRMATIONS=1
VERUM_EVM_EXPLORER_BASE=
VERUM_EVM_V2_ESCROW_ADDRESS=    # VerumOTCEscrowV2EVM (ADR-v4: 2–4 cadeiras + HTLC) — definido, SUBSTITUI o V1. Sepolia: 0x6362B1aFb1279214F58Fe8769049F078BACfC38F
# Solana (programa verum_otc em devnet). Keypairs = JSON array de 64 bytes (solana-keygen).
SOLANA_RPC_URL=
SOLANA_CHAIN_ID=            # 101 mainnet-beta | 102 testnet | 103 devnet
SOLANA_PROGRAM_ID=
SOLANA_EXECUTOR_KEYPAIR=
SOLANA_ATTESTOR_KEYPAIR=
SOLANA_TUSDT_MINT=
SOLANA_TBTC_MINT=
SOLANA_CONFIRMATIONS=1
# Tron (VerumOTCEscrowTron na Nile). tronweb é carregado sob demanda só com o grupo completo.
TRON_FULL_HOST=             # https://nile.trongrid.io
TRON_CHAIN_ID=              # 3448148188 (Nile) | 728126428 (mainnet — bloqueada sem auditoria)
TRON_ESCROW_ADDRESS=
TRON_EXECUTOR_KEY=
TRON_ATTESTOR_KEY=
TRON_TUSDT=                 # Nile: TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj (conferir decimals=6 on-chain)
TRON_TBTC=
TRON_CONFIRMATIONS=19
# Bitcoin nativo (HTLC P2WSH REAL via Esplora) — grupo ALL-OR-NOTHING; ausente = simulador regtest.
# Testnet4 público: https://mempool.space/testnet4/api (faucet: https://mempool.space/testnet4/faucet)
# Regtest local (bitcoind+electrs): http://127.0.0.1:3002 · Mainnet: https://blockstream.info/api (bloqueada sem auditoria)
BITCOIN_ESPLORA_URL=
BITCOIN_NETWORK=            # mainnet | testnet | regtest (testnet cobre testnet3/testnet4/signet — prefixo tb1)
BITCOIN_CLAIM_KEY=          # keeper do claim (hex 32 bytes) — o payout vai ao endereço BTC do COMPRADOR
BITCOIN_REFUND_KEY=         # keeper do refund pós-CSV — o payout volta ao endereço BTC do VENDEDOR
BITCOIN_CONFIRMATIONS=3     # confirmações p/ considerar o lock financiado (testnet: 1 acelera o fluxo)
BITCOIN_CSV_BLOCKS=144      # timelock do refund (~24h); PRECISA ser ≫ janela do escrow (40 min)
BITCOIN_FEE_FLOOR_SAT_VB=2
