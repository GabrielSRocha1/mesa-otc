# VERUM OTC — variáveis de ambiente (nunca commitar valores reais; produção lê de secret manager)
OTC_ENV=dev                 # dev | testnet | staging | prod
PORT=8080
HOST=127.0.0.1
DATABASE_MODE=memory        # memory | pglite | postgres (prod exige postgres + DATABASE_URL)
DATABASE_URL=
SESSION_SECRET=             # >= 32 caracteres, rotacionável; obrigatório em prod
SESSION_TTL_MS=600000
OPERATOR_ADDRESSES=         # endereços de operadores (backoffice), separados por vírgula
TREASURY_ADDRESS=0x000000000000000000000000000000000000dEaD
PLATFORM_FEE_BPS=3          # taxa da plataforma em bps: 3 = 0,03% = 0.0003 (fee = volume * 0.0003)
PAYMASTER_SHARE_BPS=0
EXEC_MARGIN_MS=60000
MAX_DEAL_USD=100000
EXPIRY_SCAN_MS=5000
APP_DOMAIN=otc.verumcrypto.com
PORTAL_HTML_PATH=./web/verum-saas.html      # portal Pay Master (cadastro/login) em /portal
MESA_HTML_PATH=./web/verum-dashboard.html   # mesa de operação em /mesa
CONVITE_HTML_PATH=./web/verum-convite.html  # página de confirmação do convite em /convite/:token
# Zcash lê saldo pelo lightwalletd público (zec.rocks, SEM chave). As chaves abaixo são só fallback opcional.
NOWNODES_API_KEY=           # opcional: fallback NOWNodes (nownodes.io, plano free) via Blockbook
BLOCKCHAIR_API_KEY=         # opcional: fallback Blockchair (blockchair.com/api, paga)
TRONGRID_API_KEY=           # chave TronGrid (trongrid.io) p/ saldo/TRC-20 do Tron; sem ela, IP compartilhado (serverless) pode ser limitado e o Tron fica "indisponível"
LOG_LEVEL=info

# ============================================================================
# Escrow canônico Verum (contratos verum-otc-onchain) — grupos ALL-OR-NOTHING.
# Grupo incompleto = erro de boot; grupo ausente = modo simulado (LocalChainAdapter).
# ============================================================================
# EVM (VerumOTCEscrowEVM em anvil/Sepolia). Tem precedência sobre o modo EVM_* legado.
VERUM_EVM_RPC_URL=
VERUM_EVM_CHAIN_ID=         # 31337 (anvil) | 11155111 (Sepolia)
VERUM_EVM_ESCROW_ADDRESS=
VERUM_EVM_KEEPER_KEY=       # executor/relayer — NUNCA a chave de um participante
VERUM_EVM_ATTESTOR_KEY=     # assina WalletAttestations (testnet: backend; mainnet: HSM/KMS)
VERUM_EVM_TBTC=
VERUM_EVM_TUSDT=
VERUM_EVM_CONFIRMATIONS=1
VERUM_EVM_EXPLORER_BASE=
VERUM_EVM_V2_ESCROW_ADDRESS=    # VerumOTCEscrowV2EVM (ADR-v4: 2–4 cadeiras + HTLC) — definido, SUBSTITUI o V1. Sepolia (comissão on-chain): 0xe3A4015B5d82efcdDc439f1d75a348A043Fc4E0A
# Solana (programa verum_otc em devnet). Keypairs = JSON array de 64 bytes (solana-keygen).
SOLANA_RPC_URL=
SOLANA_CHAIN_ID=            # 101 mainnet-beta | 102 testnet | 103 devnet
SOLANA_PROGRAM_ID=
SOLANA_EXECUTOR_KEYPAIR=
SOLANA_ATTESTOR_KEYPAIR=
SOLANA_TUSDT_MINT=
SOLANA_TBTC_MINT=
SOLANA_CONFIRMATIONS=1
# Tron (VerumOTCEscrowTron na Nile). tronweb é carregado sob demanda só com o grupo completo.
TRON_FULL_HOST=             # https://nile.trongrid.io
TRON_CHAIN_ID=              # 3448148188 (Nile) | 728126428 (mainnet — bloqueada sem auditoria)
TRON_ESCROW_ADDRESS=
TRON_EXECUTOR_KEY=
TRON_ATTESTOR_KEY=
TRON_TUSDT=                 # Nile: TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj (conferir decimals=6 on-chain)
TRON_TBTC=
TRON_CONFIRMATIONS=19
# Bitcoin nativo (HTLC P2WSH REAL via Esplora) — grupo ALL-OR-NOTHING; ausente = simulador regtest.
# Signet público (RECOMENDADO p/ teste — blocos regulares, ao contrário do testnet4): https://mempool.space/signet/api
#   faucets: https://bitcoinsignetfaucet.com/ · https://signetfaucet.com/ (endereço tb1…)
# Testnet4 público: https://mempool.space/testnet4/api (ATENÇÃO: minerava blocos vazios — lock pode não confirmar)
# Regtest local (bitcoind+electrs): http://127.0.0.1:3002 · Mainnet: https://blockstream.info/api (bloqueada sem auditoria)
BITCOIN_ESPLORA_URL=       # signet: https://mempool.space/signet/api
BITCOIN_NETWORK=           # mainnet | testnet | signet | regtest (signet e testnet usam o mesmo prefixo tb1)
BITCOIN_CLAIM_KEY=          # keeper do claim (hex 32 bytes) — o payout vai ao endereço BTC do COMPRADOR. A MESMA chave serve em signet/testnet (só muda o Esplora)
BITCOIN_REFUND_KEY=         # keeper do refund pós-CSV — o payout volta ao endereço BTC do VENDEDOR
BITCOIN_CONFIRMATIONS=1     # confirmações p/ considerar o lock financiado (signet/testnet: 1 acelera o fluxo)
BITCOIN_CSV_BLOCKS=144      # timelock do refund (~24h); PRECISA ser ≫ janela do escrow (40 min)
BITCOIN_FEE_FLOOR_SAT_VB=2
# Lightning Network (rota LIGHTNING_SWAP — perna BTC em segundos; HTLC on-chain acima segue como
# fallback). Grupo all-or-nothing LND_REST_URL+LND_MACAROON+LND_TLS_CERT. Guia: docs/SETUP-LIGHTNING.md
LND_SIMULATE=1             # 1 = simulador in-process (preview/teste). Produção: 0 com o grupo real.
LND_REST_URL=              # ex.: https://127.0.0.1:8081 (Polar) ou https://seu-no:8080
LND_MACAROON=              # macaroon em HEX, escopo mínimo (invoice+offchain+readonly)
LND_TLS_CERT=              # tls.cert do nó (PEM ou base64) — NUNCA logar
LND_INVOICE_EXPIRY_SEC=600 # expiry curto da invoice (~10 min)
LND_PAYMENT_TIMEOUT_SEC=60 # teto do pagamento Lightning
# Endpoints de LEITURA de saldo por rede (precheck/indicadores da mesa) — default: mainnet pública.
# Para testes com wallets em testnet, aponte as redes usadas para as testnets:
CHAIN_ENDPOINT_BITCOIN=     # ex.: https://mempool.space/testnet4/api
CHAIN_ENDPOINT_ETHEREUM=    # ex.: https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ENDPOINT_SOLANA=      # ex.: https://api.devnet.solana.com
CHAIN_ENDPOINT_TRON=        # ex.: https://api.shasta.trongrid.io (escrow de teste está na Shasta)
# Preços continuam vindo do mercado público (CoinGecko, ids mainnet) — tokens de teste são
# exibidos ao preço do ativo real correspondente, que é o comportamento desejado em testnet.

OPERACAO_HTML_PATH=./web/verum-operacao.html  # visualização somente-leitura de operação em /op/:dealId

# ---- Operar Indexado (preço indexado ao Verum Swap) ----
# Endpoint SERVER-SIDE do motor de swap da Verum (POST {URL}/api/swap/quote) + chave. Grupo
# all-or-nothing: defina os DOIS ou nenhum. Ausente em PROD ⇒ modo indexado DESLIGADO (fail-closed,
# nunca simula preço em produção). Em dev/testnet sem URL, um mock in-process é usado (preço de dev).
VERUM_SWAP_ENGINE_URL=          # ex.: https://swap.verumcrypto.com
VERUM_SWAP_ENGINE_KEY=          # chave do motor (Bearer) — NUNCA logar
VERUM_SWAP_TIMEOUT_MS=3000      # timeout por consulta ao motor (AbortController)
VERUM_SWAP_MIN_PROVIDERS=2      # mínimo de fontes válidas p/ a mediana (senão INDEX_UNRELIABLE)
VERUM_SWAP_MAX_DISPERSION_BPS=100  # dispersão máxima (max-min)/mediana entre fontes (1% = 100 bps)
VERUM_SWAP_SPREAD_BPS_MIN=-500  # limite inferior do spread (bps com sinal)
VERUM_SWAP_SPREAD_BPS_MAX=500   # limite superior do spread (bps com sinal)
VERUM_SWAP_MAX_MOVE_BPS=100     # refixing que divergir mais que isso exige confirmação explícita
VERUM_SWAP_FIXING_TTL_SEC=600   # validade do fixing (deve cobrir a janela de assinaturas)
