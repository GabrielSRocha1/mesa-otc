{
  "name": "verum-otc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VERUM OTC — plataforma institucional OTC/P2P multichain com liquidação N-de-N",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "start": "node dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "dashboard": "node scripts/dashboard.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test && npm run contracts:compile",
    "contracts:forge": "forge test",
    "contracts:lint": "forge lint contracts/VerumOtcEscrow.sol"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "bs58": "^6.0.0",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "tweetnacl": "^1.0.3",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ethereumjs/common": "^4.4.0",
    "@ethereumjs/util": "^9.1.0",
    "@ethereumjs/vm": "^8.1.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "solc": "^0.8.30",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "tmp": "^0.2.7"
  }
}
