// SPDX-License-Identifier: BUSL-1.1
pragma solidity ^0.8.24;

import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";
import {EIP712} from "@openzeppelin/contracts/utils/cryptography/EIP712.sol";
import {ECDSA} from "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";

/**
 * @title VerumOtcEscrow (EVM, v1)
 * @notice Módulos on-chain da arquitetura §11: DealManager, Escrow, SignatureValidator (EIP-712), SettlementEngine,
 *         FeeRouter, AssetRegistry (allowlist com timelock), NonceManager e EmergencyControls.
 *
 * Invariante de custódia: nenhuma função move fundos para destino que não seja (a) o `to` da leg em `settle`,
 * (b) o depositante em `refund`, (c) a tesouraria fixada no register (fee). Não existe withdraw/sweep/upgrade.
 * `refund` NUNCA é pausável. `settle` exige N assinaturas válidas (uma por papel) sobre o mesmo dealHash,
 * nonces não consumidos, deal FUNDED e não expirada (margem de execução). Efeitos antes das interações.
 */
contract VerumOtcEscrow is EIP712, AccessControl, Pausable, ReentrancyGuard {
    using SafeERC20 for IERC20;

    bytes32 public constant REGISTRAR_ROLE = keccak256("REGISTRAR_ROLE"); // keeper: apenas register/supersede (sem poder sobre destinos)
    bytes32 public constant GUARDIAN_ROLE = keccak256("GUARDIAN_ROLE");   // pausa de entrada; nunca de refund
    bytes32 public constant ADMIN_ROLE = keccak256("ADMIN_ROLE");         // allowlist de tokens, com timelock
    uint64 public constant EXEC_MARGIN_MS = 60_000;
    uint64 public constant ALLOWLIST_TIMELOCK = 24 hours;
    uint16 public constant MAX_FEE_BPS = 500;
    address private constant NATIVE = address(0);

    bytes32 private constant APPROVAL_TYPEHASH = keccak256(
        "DealApproval(bytes32 dealHash,string dealId,uint32 revision,uint8 role,address signer,string nonce,uint64 expiresAt,string assetIn,uint256 amountIn,string assetOut,uint256 amountOut,string counterparty)"
    );

    enum Status { NONE, REGISTERED, FUNDED, SETTLED, REFUNDED, SUPERSEDED }

    struct LegInput { uint8 index; address token; uint256 amount; address from; address to; bool isPayment; }
    struct Leg { uint8 index; address token; uint256 amount; address from; address to; bool isPayment; bool deposited; bool settled; }
    struct RegisterInput {
        string dealId; uint32 revision; bytes32 dealHash; uint64 expiresAtMs;
        address[] participants;          // ordenados por papel: SELLER, BUYER, PAYMASTER_1[, PAYMASTER_2]
        LegInput[] legs;                 // apenas legs desta cadeia
        uint16 feeBps; bytes32 htlcHash;
        bytes32 assetInHash; uint256 amountIn; bytes32 assetOutHash; uint256 amountOut; bytes32 counterpartyHash;
    }
    struct Deal {
        bytes32 dealHash; uint32 revision; uint64 expiresAtMs; Status status; uint16 feeBps; bytes32 htlcHash;
        bytes32 dealIdHash; bytes32 assetInHash; uint256 amountIn; bytes32 assetOutHash; uint256 amountOut; bytes32 counterpartyHash;
        address[] participants; Leg[] legs; uint8 depositedCount;
    }

    /// @notice Tesouraria de fees fixada no deploy: o keeper NÃO escolhe o destino da fee por Deal (evita desvio de fee por keeper comprometido).
    address public immutable treasury;
    mapping(bytes32 => Deal) private _deals;            // keccak256(dealId) → Deal
    mapping(bytes32 => bool) public nonceUsed;          // keccak256(dealIdHash, nonce) → consumido
    mapping(address => bool) public tokenAllowed;       // AssetRegistry on-chain (allowlist)
    mapping(bytes32 => uint64) public allowlistEta;     // proposta agendada → quando pode executar

    event DealRegistered(bytes32 indexed dealIdHash, string dealId, uint32 revision, bytes32 dealHash, uint64 expiresAtMs);
    event Deposited(bytes32 indexed dealIdHash, uint8 legIndex, address indexed from, address token, uint256 amount);
    event Settled(bytes32 indexed dealIdHash, uint32 revision, bytes32 dealHash);
    event FeeCollected(bytes32 indexed dealIdHash, address token, uint256 amount, address treasury);
    event PreimageRevealed(bytes32 indexed dealIdHash, bytes32 preimage);
    event Refunded(bytes32 indexed dealIdHash, uint8 legIndex, address indexed to, address token, uint256 amount);
    event Superseded(bytes32 indexed dealIdHash, uint32 revision);
    event TokenAllowlistScheduled(address indexed token, bool allowed, uint64 eta);
    event TokenAllowlistUpdated(address indexed token, bool allowed);

    error DealExists(); error DealNotFound(); error BadStatus(Status current); error Expired(); error NotExpired(); error NotDepositor(); error AlreadyDeposited();
    error TokenNotAllowed(address token); error BadNativeValue(); error TransferAmountMismatch(); error BadSignatureCount(); error BadSigner(uint8 role);
    error NonceAlreadyUsed(uint8 role); error BadPreimage(); error FeeTooHigh(); error BadInput(); error TimelockPending(uint64 eta); error NothingToRefund(); error FundsStillEscrowed(); error BadLegParties();

    constructor(address admin, address guardian, address registrar, address treasury_) EIP712("VerumOTC", "1") {
        if (admin == address(0) || guardian == address(0) || registrar == address(0) || treasury_ == address(0)) revert BadInput();
        treasury = treasury_;
        _grantRole(DEFAULT_ADMIN_ROLE, admin); _grantRole(ADMIN_ROLE, admin); _grantRole(GUARDIAN_ROLE, guardian); _grantRole(REGISTRAR_ROLE, registrar);
        tokenAllowed[NATIVE] = true;
    }

    /* ─────────────────────────────── DealManager ─────────────────────────────── */
    function register(RegisterInput calldata inp) external whenNotPaused onlyRole(REGISTRAR_ROLE) {
        bytes32 key = keccak256(bytes(inp.dealId)); Deal storage d = _deals[key];
        if (d.status != Status.NONE && d.status != Status.SUPERSEDED && d.status != Status.REFUNDED) revert DealExists();
        if (d.status != Status.NONE && inp.revision <= d.revision) revert DealExists();
        if (d.depositedCount != 0) revert FundsStillEscrowed(); // nunca sobrescrever uma revisão com fundos ainda em custódia
        uint256 n = inp.participants.length; if (n < 3 || n > 4 || inp.legs.length == 0 || inp.legs.length > 2) revert BadInput();
        if (inp.feeBps > MAX_FEE_BPS) revert FeeTooHigh();
        if (uint64(block.timestamp) * 1000 >= inp.expiresAtMs) revert Expired();
        for (uint256 i = 0; i < n; i++) { if (inp.participants[i] == address(0)) revert BadInput(); for (uint256 j = i + 1; j < n; j++) if (inp.participants[i] == inp.participants[j]) revert BadInput(); }
        // reinicializa (nova revisão) — depósitos de revisão anterior já devolvidos via refund
        delete d.participants; delete d.legs;
        d.dealHash = inp.dealHash; d.revision = inp.revision; d.expiresAtMs = inp.expiresAtMs; d.status = Status.REGISTERED; d.feeBps = inp.feeBps; d.htlcHash = inp.htlcHash;
        d.dealIdHash = key; d.assetInHash = inp.assetInHash; d.amountIn = inp.amountIn; d.assetOutHash = inp.assetOutHash; d.amountOut = inp.amountOut; d.counterpartyHash = inp.counterpartyHash; d.depositedCount = 0;
        for (uint256 i = 0; i < n; i++) d.participants.push(inp.participants[i]);
        for (uint256 i = 0; i < inp.legs.length; i++) {
            LegInput calldata l = inp.legs[i]; if (!tokenAllowed[l.token]) revert TokenNotAllowed(l.token); if (l.amount == 0) revert BadInput();
            // As partes de cada leg são SEMPRE Vendedor↔Comprador (papéis 0 e 1): o keeper não pode apontar fundos para terceiros.
            if (l.isPayment) { if (l.from != inp.participants[1] || l.to != inp.participants[0] || l.amount != inp.amountOut) revert BadLegParties(); }
            else { if (l.from != inp.participants[0] || l.to != inp.participants[1] || l.amount != inp.amountIn) revert BadLegParties(); }
            for (uint256 j = 0; j < i; j++) if (inp.legs[j].isPayment == l.isPayment) revert BadInput();
            d.legs.push(Leg({ index: l.index, token: l.token, amount: l.amount, from: l.from, to: l.to, isPayment: l.isPayment, deposited: false, settled: false }));
        }
        emit DealRegistered(key, inp.dealId, inp.revision, inp.dealHash, inp.expiresAtMs);
    }

    function supersede(string calldata dealId, uint32 revision) external onlyRole(REGISTRAR_ROLE) {
        Deal storage d = _load(dealId); if (d.revision != revision) revert BadInput();
        if (d.status != Status.REGISTERED && d.status != Status.FUNDED) revert BadStatus(d.status);
        d.status = Status.SUPERSEDED; emit Superseded(d.dealIdHash, revision);
    }

    /* ─────────────────────────────── Escrow ─────────────────────────────── */
    function deposit(string calldata dealId, uint8 legPos) external payable whenNotPaused nonReentrant {
        Deal storage d = _load(dealId); if (d.status != Status.REGISTERED && d.status != Status.FUNDED) revert BadStatus(d.status);
        if (uint64(block.timestamp) * 1000 >= d.expiresAtMs) revert Expired();
        if (legPos >= d.legs.length) revert BadInput(); Leg storage leg = d.legs[legPos];
        if (msg.sender != leg.from) revert NotDepositor(); if (leg.deposited) revert AlreadyDeposited();
        if (leg.token == NATIVE) { if (msg.value != leg.amount) revert BadNativeValue(); }
        else { if (msg.value != 0) revert BadNativeValue(); uint256 before = IERC20(leg.token).balanceOf(address(this)); IERC20(leg.token).safeTransferFrom(msg.sender, address(this), leg.amount); if (IERC20(leg.token).balanceOf(address(this)) - before != leg.amount) revert TransferAmountMismatch(); }
        leg.deposited = true; d.depositedCount += 1; if (d.depositedCount == d.legs.length) d.status = Status.FUNDED;
        emit Deposited(d.dealIdHash, leg.index, msg.sender, leg.token, leg.amount);
    }

    /* ─────────────────────────── SettlementEngine + SignatureValidator + FeeRouter ─────────────────────────── */
    /// @notice Permissionless: qualquer chamador; o contrato decide. `nonces[i]` é o nonce (string) emitido para o papel i.
    function settle(string calldata dealId, bytes[] calldata signatures, string[] calldata nonces, bytes32 preimage) external whenNotPaused nonReentrant {
        Deal storage d = _load(dealId); if (d.status != Status.FUNDED) revert BadStatus(d.status);
        if (uint64(block.timestamp) * 1000 + EXEC_MARGIN_MS >= d.expiresAtMs) revert Expired();
        uint256 n = d.participants.length; if (signatures.length != n || nonces.length != n) revert BadSignatureCount();
        for (uint256 i = 0; i < n; i++) {
            bytes32 nonceKey = keccak256(abi.encodePacked(d.dealIdHash, nonces[i])); if (nonceUsed[nonceKey]) revert NonceAlreadyUsed(uint8(i));
            if (!_validApproval(d, uint8(i), nonces[i], signatures[i])) revert BadSigner(uint8(i));
            nonceUsed[nonceKey] = true;
        }
        if (d.htlcHash != bytes32(0)) { if (sha256(abi.encodePacked(preimage)) != d.htlcHash) revert BadPreimage(); emit PreimageRevealed(d.dealIdHash, preimage); }
        d.status = Status.SETTLED; // efeito antes das interações
        for (uint256 i = 0; i < d.legs.length; i++) {
            Leg storage leg = d.legs[i]; leg.settled = true;
            uint256 fee = leg.isPayment ? (leg.amount * d.feeBps) / 10_000 : 0;
            _pay(leg.token, leg.to, leg.amount - fee);
            if (fee > 0) { _pay(leg.token, treasury, fee); emit FeeCollected(d.dealIdHash, leg.token, fee, treasury); }
        }
        emit Settled(d.dealIdHash, d.revision, d.dealHash);
    }

    /* ─────────────────────────────── Refund (nunca pausável) ─────────────────────────────── */
    function refund(string calldata dealId, uint8 legPos) external nonReentrant {
        Deal storage d = _load(dealId); if (d.status == Status.SETTLED) revert BadStatus(d.status);
        bool expired = uint64(block.timestamp) * 1000 >= d.expiresAtMs; if (!expired && d.status != Status.SUPERSEDED) revert NotExpired();
        if (legPos >= d.legs.length) revert BadInput(); Leg storage leg = d.legs[legPos]; if (!leg.deposited) revert NothingToRefund();
        leg.deposited = false; d.depositedCount -= 1; if (d.depositedCount == 0 && d.status != Status.SUPERSEDED) d.status = Status.REFUNDED;
        _pay(leg.token, leg.from, leg.amount); emit Refunded(d.dealIdHash, leg.index, leg.from, leg.token, leg.amount);
    }

    /* ─────────────────────────────── AssetRegistry (allowlist + timelock) ─────────────────────────────── */
    function scheduleToken(address token, bool allowed) external onlyRole(ADMIN_ROLE) { bytes32 k = keccak256(abi.encode(token, allowed)); uint64 eta = uint64(block.timestamp) + ALLOWLIST_TIMELOCK; allowlistEta[k] = eta; emit TokenAllowlistScheduled(token, allowed, eta); }
    function executeToken(address token, bool allowed) external onlyRole(ADMIN_ROLE) { bytes32 k = keccak256(abi.encode(token, allowed)); uint64 eta = allowlistEta[k]; if (eta == 0 || block.timestamp < eta) revert TimelockPending(eta); delete allowlistEta[k]; tokenAllowed[token] = allowed; emit TokenAllowlistUpdated(token, allowed); }

    /* ─────────────────────────────── EmergencyControls ─────────────────────────────── */
    function pause() external onlyRole(GUARDIAN_ROLE) { _pause(); }
    function unpause() external onlyRole(GUARDIAN_ROLE) { _unpause(); }

    /* ─────────────────────────────── Views ─────────────────────────────── */
    function dealStatus(string calldata dealId) external view returns (Status status, uint32 revision, bytes32 dealHash, uint64 expiresAtMs, uint8 depositedCount, uint8 legCount) {
        Deal storage d = _deals[keccak256(bytes(dealId))]; return (d.status, d.revision, d.dealHash, d.expiresAtMs, d.depositedCount, uint8(d.legs.length));
    }
    function legOf(string calldata dealId, uint8 legPos) external view returns (Leg memory) { return _deals[keccak256(bytes(dealId))].legs[legPos]; }
    function participantsOf(string calldata dealId) external view returns (address[] memory) { return _deals[keccak256(bytes(dealId))].participants; }
    function domainSeparator() external view returns (bytes32) { return _domainSeparatorV4(); }

    /* ─────────────────────────────── internos ─────────────────────────────── */
    /// @dev SignatureValidator: reconstrói o struct EIP-712 DealApproval a partir do que o contrato guarda (nunca do chamador).
    function _validApproval(Deal storage d, uint8 role, string calldata nonce, bytes calldata signature) private view returns (bool) {
        // EIP-712: hashStruct = keccak256(typeHash ‖ enc(fields)); enc é a concatenação de todos os campos codificados em 32 bytes,
        // logo keccak256(abi.encode(...todos)) == keccak256(bytes.concat(abi.encode(head_fields), abi.encode(tail_fields))).
        bytes32 structHash = keccak256(bytes.concat(abi.encode(APPROVAL_TYPEHASH, d.dealHash, d.dealIdHash, d.revision, role, d.participants[role], keccak256(bytes(nonce))), abi.encode(d.expiresAtMs, d.assetInHash, d.amountIn, d.assetOutHash, d.amountOut, d.counterpartyHash)));
        (address rec, ECDSA.RecoverError err, ) = ECDSA.tryRecover(_hashTypedDataV4(structHash), signature);
        return err == ECDSA.RecoverError.NoError && rec == d.participants[role];
    }
    function _load(string calldata dealId) private view returns (Deal storage d) { d = _deals[keccak256(bytes(dealId))]; if (d.status == Status.NONE) revert DealNotFound(); }
    function _pay(address token, address to, uint256 amount) private { if (amount == 0) return; if (token == NATIVE) { (bool ok, ) = payable(to).call{value: amount}(""); if (!ok) revert TransferAmountMismatch(); } else IERC20(token).safeTransfer(to, amount); }
}
